/* left card start */
  .card{
    text-align:start;
    margin-bottom: 30px;
    padding:30px;
    margin-left: 100px;
    width: 130%;
    background-color:rgba(219, 208, 208, 0.621);
  
  }
  .cards img{
    width: 130%;
    height: 100%;
    margin-left: 100px;
  }
  .box{
    text-align: center;
    align-items: center;
    text-decoration: none;
    color: black;
    font-size: medium;
    font-weight: bold;
  }


          <!--start left side box-->
          <div class="container-fluid" >
            <div class="row cards align-items-center">
              <div class="col-md-4">
                <a href="" class="img"><img src="KFC-Wednesday-Special-app.jpg.webp" alt=""></a>
                <div class="card">
                <a href="" class="box"><span>WEDNESDAY SPECIAL</span></a>
                </div>
              </div>
            </div>
          </div>


 
